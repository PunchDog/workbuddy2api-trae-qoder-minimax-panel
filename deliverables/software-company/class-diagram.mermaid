classDiagram
    %% ===== Go: 静态资源与网关 =====
    class frontend_embed {
        <<package>>
        +embed.FS DistFS
        +IndexHTML() byte[], error
        +Open(name string) File, error
    }
    class panel_Assets {
        +ServeIndex(w, r)
        +ServeAsset(w, r)
        +setSecurityHeaders(w)
        -indexETag string
    }
    class panel_Panel {
        -Config cfg
        -ServeMux mux
        -Ring logs
        +New(Config) Panel
        +ServeHTTP(w, r)
        +withAuth(next) HandlerFunc
        -overview(w, r)
        -registerStatsRoutes(mux)
        -routes()
    }
    class panel_Config {
        +Pool
        +Upstream
        +Scheduler
        +Live *livecfg.Holder
        +Usage
        +RequestLog
        +SaveConfig
    }
    class panel_Stats {
        +timeseries(w, r)
        +heatmap(w, r)
        +breakdown(w, r)
    }
    class usage_Stats {
        <<package>>
        +SeriesWindow() Points
        +Heatmap() Cell[]
        +SnapshotWindow() Breakdown
    }
    class appserver {
        <<package>>
        +Run()
        +Load(path) Config
    }

    %% ===== Go: 单 exe 启动器 + 桌面壳 =====
    class cmd_app {
        <<package main>>
        +main()
        -launch() void
        -listenAddrFromConfig() string
        -dialAddr(listen) string
        -portReady(addr) bool
        -stopServer() void
    }
    class desktop {
        <<windows && !server>>
        +startDesktop(url, stopGateway, title) error
        -window WebviewWindow
        -tray SystemTray
        -onWindowClosing(e) void
    }
    class desktop_server {
        <<windows && server>>
        +startDesktop(url, stopGateway, title) error
    }

    %% ===== 前端 Vue 3 =====
    class ApiClient {
        +api~T~(path: string, opts: RequestInit) Promise~T~
        +apiUpload~T~(path, form) Promise~T~
        +withQuery(path, params) string
        -keyFromStorage() string
        -inflight: Map~string, Promise~
    }
    class StatsApi {
        +getTimeseries(query) Promise~TimeseriesResponse~
        +getHeatmap(query) Promise~HeatmapResponse~
        +getBreakdown(query) Promise~BreakdownResponse~
        +statsRangeFromState(state) StatsRange
    }
    class ThemeComposable {
        +mode: auto|light|dark
        +tokens: ThemeTokens
        +applyTheme()
        -watchSystem()
    }
    class ViewBase {
        <<interface>>
        +load()
        +refresh()
        +viewKey: string
    }
    class CheckinView
    class UsageView
    class PackagesView
    class TasksCenterView
    class IdeAccountsView
    class ModelsView
    class ConfigView
    class LogsView
    class EChartBase {
        +option: EChartsOption
        +registerCharts()
        +onThemeChanged()
        +onResize()
    }
    class TrendChart
    class HeatmapChart
    class BreakdownChart
    class DialogBase {
        <<interface>>
        +visible: boolean
        +submit()
        +cancel()
    }
    class AddAccountDialog
    class KpiCard {
        +label: string
        +value: string
        +tone: ok|warn|bad|neutral
    }
    class PlatformCard {
        +platform: string
        +status: string
        +quota: number
    }

    %% ===== 关系 =====
    frontend_embed ..> panel_Assets : DistFS
    panel_Assets ..> panel_Panel : registers 2 static routes
    panel_Panel --> panel_Config : Config
    panel_Panel --> panel_Stats : registerStatsRoutes
    panel_Stats ..> usage_Stats : 只读聚合
    appserver --> panel_Panel : panel.New + mux.Handle(/panel/)
    cmd_app --> appserver : --server
    cmd_app --> desktop : 默认模式 (windows && !server)
    cmd_app --> desktop_server : -tags server 降级
    desktop ..> cmd_app : URL from listenAddrFromConfig
    ApiClient ..> panel_Panel : HTTP /panel/api/*
    StatsApi --> ApiClient : 同端点封装
    ViewBase <|.. CheckinView
    ViewBase <|.. UsageView
    ViewBase <|.. PackagesView
    ViewBase <|.. TasksCenterView
    ViewBase <|.. IdeAccountsView
    ViewBase <|.. ModelsView
    ViewBase <|.. ConfigView
    ViewBase <|.. LogsView
    DialogBase <|.. AddAccountDialog
    CheckinView --> ApiClient
    CheckinView --> KpiCard
    CheckinView --> PlatformCard
    UsageView --> StatsApi
    UsageView --> EChartBase
    EChartBase <|-- TrendChart
    EChartBase <|-- HeatmapChart
    EChartBase <|-- BreakdownChart
    CheckinView --> ThemeComposable
    UsageView --> ThemeComposable
